{
    "name": "semitexa/authorization",
    "description": "Semitexa Authorization - policy-based access checks, guards, and permission evaluation",
    "type": "semitexa-module",
    "license": "MIT",
    "require": {
        "php": "^8.4",
        "semitexa/core": ">=2026.10.08.0620 || dev-master",
        "semitexa/auth": "*"
    },
    "autoload": {
        "psr-4": {
            "Semitexa\\Authorization\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Semitexa\\Authorization\\Tests\\": "tests/"
        }
    },
    "extra": {
        "semitexa-module": {
            "extends": null
        },
        "semitexa": {
            "floors": {
                "semitexa/core": "2026.10.08.0620"
            }
        }
    },
    "keywords": [
        "semitexa",
        "authorization",
        "policies",
        "permissions",
        "guards",
        "access-control"
    ]
}
